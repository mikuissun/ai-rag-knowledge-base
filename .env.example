# MySQL application connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_knowledge_base
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# MySQL container initialization (required when starting Docker Compose)
MYSQL_ROOT_PASSWORD=

# Authentication (required for login token generation)
JWT_SECRET=
JWT_EXPIRATION_SECONDS=86400

# Qdrant HTTP/management and Java gRPC endpoints
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=knowledge_chunks
QDRANT_BATCH_SIZE=100
QDRANT_TIMEOUT_SECONDS=15

# DashScope Embedding and Qwen Chat configuration
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_READ_TIMEOUT_SECONDS=120
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_EMBEDDING_BATCH_SIZE=10
DASHSCOPE_CONNECT_TIMEOUT_SECONDS=10
DASHSCOPE_READ_TIMEOUT_SECONDS=60

# RAG text chunking (Stage 5; vector retrieval starts in a later stage)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_CHUNKS_PER_DOCUMENT=500
RAG_SEARCH_TOP_K=5
RAG_MAX_SEARCH_TOP_K=20
RAG_MIN_SCORE=0.5
RAG_MAX_CONTEXT_CHARS=12000
RAG_SSE_TIMEOUT_SECONDS=120

# Local document storage (relative to the backend process working directory)
STORAGE_BASE_PATH=./data/uploads

# Frontend
VITE_API_BASE_URL=http://localhost:8080
